# ==============================================================================
# Configurações do Banco de Dados PostgreSQL
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cortechx_meeting

# URL de conexão no ambiente Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/cortechx_meeting

# Para rodar a API localmente (fora do Docker) com o banco do docker-compose:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/cortechx_meeting

# ==============================================================================
# Configurações da Aplicação
# ==============================================================================
APP_DEBUG=false

# ==============================================================================
# Armazenamento e Upload de Áudio (Issue #9)
# ==============================================================================
AUDIO_STORAGE_PATH=storage/meetings
MAX_AUDIO_SIZE_MB=250

# ==============================================================================
# Speech-to-Text (STT) - Whisper e Provedores (Issue #9)
# ==============================================================================
# Chave opcional da Groq para transcrição ultra-rápida via Whisper-large-v3 na nuvem (Free Tier).
# Se vazia, o sistema utilizará o faster-whisper local com o modelo small e Silero VAD.
GROQ_API_KEY=

# Configurações do Whisper local (quando sem GROQ_API_KEY)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# TOKEN HUGGING FACE PARA DIARIZAÇÃO
HUGGINGFACE_TOKEN=

# ==============================================================================
# Integrações Externas e Provedores de IA
# ==============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
# Integração com o Notion (Issue #31):
# NOTION_API_KEY  = Internal Integration Secret de notion.so/my-integrations
# NOTION_DATABASE_ID = data source da database de reuniões; a database
#   precisa estar conectada à integração e ter as properties Name (título),
#   meeting_id (número), Data (data) e Status (seleção).
#   Detalhes em docs/estrategia-integracao-notion.md
NOTION_API_KEY=
NOTION_DATABASE_ID=
DISCORD_WEBHOOK_URL=

# ==============================================================================
# Provedor de LLM Centralizado (Issue #15)
# ==============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=